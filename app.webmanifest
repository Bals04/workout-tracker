{
  "name": "Bals workout planner",
  "short_name": "Bals Planner",
  "description": "Plan and track your Monday-to-Friday workouts. Set your own sets and reps, mark rest days. Works offline.",
  "start_url": "./?src=pwa",
  "scope": "./",
  "id": "bals-workout-planner",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0B0D10",
